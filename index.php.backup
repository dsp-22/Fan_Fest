<?php
session_start();

// 1. Security Check: Redirect to Login if not logged in
if (!isset($_SESSION['user_id'])) {
    header("Location: login.php");
    exit();
}

// 2. Get User Name (default to "Fan" if missing)
$user_name = isset($_SESSION['first_name']) ? htmlspecialchars($_SESSION['first_name']) : "Fan";
?>

